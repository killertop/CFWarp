[Unit]
Description=CFwarp runtime health watchdog
After=cfwarp.service

[Service]
Type=oneshot
Environment=CFWARP_ENV_FILE=@ENV_FILE@
WorkingDirectory=@INSTALL_PREFIX@
ExecStart=/bin/sh @INSTALL_PREFIX@/cfwarp-watchdog.sh
TimeoutStartSec=6min
UMask=0077
PrivateTmp=false
ProtectHome=false
NoNewPrivileges=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
