# CFwarp private environment template.
# Copy this file to /etc/cfwarp/cfwarp.env; do not commit the private copy.

# Default: WARP lives in a dedicated network namespace and the host route is
# unchanged. Use host-global only when you explicitly need host-wide routing.
CFWARP_MODE=netns-proxy
CFWARP_DATA_DIR=/var/lib/cfwarp
WG_INTERFACE=wg0
# WG_CONF_DIR=/var/lib/cfwarp

# Namespace and veth settings. Interface names must be <= 15 characters.
NETNS_NAME=cfwarp
NETNS_HOST_IF=cfwarp-host
NETNS_NS_IF=cfwarp-ns
NETNS_HOST_ADDR=169.254.240.1/30
NETNS_PEER_ADDR=169.254.240.2/30
NETNS_CIDR=169.254.240.0/30
NETNS_PEER_HOST=169.254.240.2
# NETNS_OUT_IF=eth0

# In netns-proxy mode this binds only to the namespace veth address.
# In host-global mode prefer 127.0.0.1 unless authentication is configured.
BIND_ADDR=169.254.240.2
BIND_PORT=1080
MICROSOCKS_QUIET=1
# SOCKS_USER=<private-user>
# SOCKS_PASS=<private-password>

# Optional fixed WARP Endpoint. Keep empty to use the generated profile.
# ENDPOINT_IP=<host-or-ip>:<port>
# ENDPOINT_CANDIDATES=<host-or-ip>:<port>,<host-or-ip>:<port>

# wgcf is intentionally pinned. The default version has built-in SHA256 values
# for amd64 and arm64. A custom version must include its own SHA256.
# WGCF_VERSION=2.2.30
# WGCF_SHA256=<64-hex-digest>
# GH_PROXY=https://<trusted-download-proxy>

# WARP startup and trace checks.
WARP_MTU=1280
WARP_PERSISTENT_KEEPALIVE=15
WARP_READY_ATTEMPTS=6
WARP_READY_DELAY_SECONDS=2
WARP_HEALTHCHECK_CONNECT_TIMEOUT=4
WARP_HEALTHCHECK_TOTAL_TIMEOUT=8
WARP_HEALTHCHECK_TRACE_URL=https://1.1.1.1/cdn-cgi/trace
WARP_HEALTHCHECK_TEST_URL=https://www.gstatic.com/generate_204

# Runtime health check and watchdog.
CFWARP_HEALTH_WAIT_SECONDS=90
CFWARP_HEALTH_INTERVAL_SECONDS=2
CFWARP_HEALTH_RETRIES=2
CFWARP_HEALTH_RETRY_DELAY_SECONDS=1
CFWARP_HEALTH_WARN_TOTAL_SECONDS=2
# CFWARP_HEALTH_METRICS_FILE=/run/cfwarp/health.env
CFWARP_WATCHDOG_RETRIES=3
CFWARP_WATCHDOG_RETRY_DELAY_SECONDS=2
CFWARP_WATCHDOG_FAILURE_THRESHOLD=2
CFWARP_WATCHDOG_RESTART_COOLDOWN_SECONDS=900

# Endpoint refresh is opt-in. 'stop-and-probe' briefly stops an active service.
CFWARP_ENDPOINT_REFRESH_ACTIVE_MODE=skip
CFWARP_ENDPOINT_PROBE_SAMPLES=2
CFWARP_ENDPOINT_PROBE_URL=https://1.1.1.1/cdn-cgi/trace
CFWARP_ENDPOINT_SWITCH_MIN_IMPROVEMENT_PERCENT=15
# CFWARP_ENDPOINT_CANDIDATE_TIMEOUT_SECONDS=35
