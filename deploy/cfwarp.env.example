# 裸机默认采用 netns-proxy，只在独立 namespace 内接管 WARP。
# 如需显式改回宿主机全局接管，设置为 host-global。
CFWARP_MODE=netns-proxy

# WireGuard 持久化状态目录与运行配置路径。
# 默认安装会把它渲染成当前安装根目录下的 var 目录；
# 如果检测到旧版 /var/lib/microwarp 数据，install.sh 会优先迁移/复用。
CFWARP_DATA_DIR=__CFWARP_DATA_DIR__
WG_INTERFACE=wg0
# WG_CONF_DIR=__CFWARP_DATA_DIR__

# netns 模式下，SOCKS5 实际监听在独立 namespace 内。
# 宿主机上的项目请连接 NETNS_PEER_HOST:BIND_PORT。
NETNS_NAME=cfwarp
# 下面两个 veth 接口名必须不超过 15 个字符。
NETNS_HOST_IF=cfwarp-host
NETNS_NS_IF=cfwarp-ns
NETNS_HOST_ADDR=169.254.240.1/30
NETNS_PEER_ADDR=169.254.240.2/30
NETNS_CIDR=169.254.240.0/30
NETNS_PEER_HOST=169.254.240.2
# NETNS_OUT_IF=eth0

# netns-proxy 模式建议保持 0.0.0.0，便于宿主机通过 veth 对端地址访问。
# host-global 模式可按需改成 127.0.0.1。
BIND_ADDR=0.0.0.0
BIND_PORT=1080

# 同时填写才会启用认证；只填一个会导致启动失败。
# SOCKS_USER=admin
# SOCKS_PASS=change-me

# 可选：自定义 WARP Endpoint，用于特殊网络环境下的连通性优化。
# ENDPOINT_IP=162.159.192.1:4500
# ENDPOINT_CANDIDATES=162.159.192.1:2408,162.159.192.1:4500,188.114.96.7:2408

# 可选：WARP 就绪检查与重试参数。
# netns-proxy 模式下，这些值也会传入独立 namespace 内的 WARP 进程。
# WARP_READY_ATTEMPTS=6
# WARP_READY_DELAY_SECONDS=2
# WARP_HEALTHCHECK_CONNECT_TIMEOUT=4
# WARP_HEALTHCHECK_TOTAL_TIMEOUT=8
# WARP_HEALTHCHECK_TRACE_URL=https://1.1.1.1/cdn-cgi/trace
# WARP_HEALTHCHECK_TEST_URL=https://www.gstatic.com/generate_204

# 可选：每日自动 Endpoint 选择的探测参数。
# timer 会每天运行一次 cfwarp-endpoint-refresh.service，
# 在 ENDPOINT_IP + ENDPOINT_CANDIDATES 中挑选当前更优的节点并回写 ENDPOINT_IP。
# 默认值 skip 表示当 cfwarp.service 正在运行时直接跳过，避免为探测停掉现网代理；
# 如确实要允许刷新任务停服评估，再显式改成 stop-and-probe。
# CFWARP_ENDPOINT_REFRESH_ACTIVE_MODE=skip
# CFWARP_ENDPOINT_PROBE_SAMPLES=2
# CFWARP_ENDPOINT_PROBE_URL=https://1.1.1.1/cdn-cgi/trace

# 可选：加速下载 wgcf 二进制。
# GH_PROXY=https://github.example.com

# 可选：Tailscale 回程路由 CIDR，默认 100.64.0.0/10。
# TAILSCALE_CIDR=100.64.0.0/10
