#!/bin/sh
set -eu

SCRIPT_PATH=$0
while [ -L "$SCRIPT_PATH" ]; do
    SCRIPT_LINK=$(readlink "$SCRIPT_PATH")
    case "$SCRIPT_LINK" in
        /*) SCRIPT_PATH=$SCRIPT_LINK ;;
        *) SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$SCRIPT_LINK" ;;
    esac
done
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname "$SCRIPT_PATH")" && pwd)
if [ ! -r "${SCRIPT_DIR}/lib/cfwarp-common.sh" ] && [ -r "${SCRIPT_DIR}/../lib/cfwarp-common.sh" ]; then
    SCRIPT_DIR=$(CDPATH='' cd -- "${SCRIPT_DIR}/.." && pwd)
fi
COMMON_FILE="${SCRIPT_DIR}/lib/cfwarp-common.sh"
if [ ! -r "$COMMON_FILE" ]; then
    echo "找不到共享库: $COMMON_FILE" >&2
    exit 1
fi
# shellcheck disable=SC1090
. "$COMMON_FILE"

if [ $# -eq 0 ]; then
    echo "用法: cfwarp-exec <command> [args...]" >&2
    exit 1
fi

cfwarp_load_env "$SCRIPT_DIR" || exit 1
CFWARP_MODE=${CFWARP_MODE:-netns-proxy}
NETNS_NAME=${NETNS_NAME:-cfwarp}
cfwarp_validate_netns_name "$NETNS_NAME" || exit 1
if [ "$(id -u)" -ne 0 ]; then
    echo "cfwarp-exec requires root to enter the namespace; run with sudo." >&2
    exit 1
fi

if [ "$CFWARP_MODE" = "host-global" ]; then
    echo "当前 CFWARP_MODE=host-global，没有可加入的独立 namespace。" >&2
    exit 1
fi
if [ "$CFWARP_MODE" != "netns-proxy" ]; then
    echo "不支持的 CFWARP_MODE: $CFWARP_MODE" >&2
    exit 1
fi
# The helper holds the namespace ownership lock through validation and entry,
# then releases it inside that namespace. Its kernel egress guard survives
# tunnel loss and remains effective for already-running commands.
exec sh "${SCRIPT_DIR}/cfwarp-netns.sh" exec "$@"
